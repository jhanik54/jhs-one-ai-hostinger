# MySQL connection string. Keep server-side only.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?connection_limit=10"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
APP_URL="https://YOUR_DOMAIN"

# Persistent directory outside the deployed public web root; provision with private permissions.
PRIVATE_UPLOAD_DIR="/home/ACCOUNT/private/jh-one-ai-uploads"

# Optional first-run admin bootstrap. Must match a verified Google account.
INITIAL_SUPERADMIN_EMAIL=""

# Google OAuth; callback must be https://YOUR_DOMAIN/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://YOUR_DOMAIN/auth/callback"

# Provider pools; add any numeric index without code changes.
GEMINI_KEY_0=""
GROQ_KEY_0=""
OPENROUTER_KEY_0=""

# Optional service controls
DISABLE_REGISTRATION="false"
